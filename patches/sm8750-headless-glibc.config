# ==============================================================================
# OnePlus 13 (dodge / SM8750 / sun) Headless Linux & Native Glibc Kconfig Fragment
# Target Repository: LineageOS/android_kernel_oneplus_sm8750 (lineage-23.2 / 24.0)
# Kernel Base: ACK 6.6 GKI 2.0 (aarch64-only Oryon)
# ==============================================================================

# 1. System V IPC & POSIX Message Queues (Mandatory for Native Glibc 2.38+ & HPC)
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# 2. Complete Linux Namespaces (For zero-distro mount/pivot_root isolation)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# 3. Filesystem & Binary Format Interception
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_MISC=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# 4. Snapdragon 8 Elite (Oryon) CPU Frequency & Scheduling
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y

# 5. SELinux Runtime Toggle for Native Glibc Execution
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
